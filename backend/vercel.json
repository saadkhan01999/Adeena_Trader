{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "echo 'No build step: the API ships as a serverless function.'",
  "installCommand": "npm install",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": { "maxDuration": 30 },
    "api/cron/notifications.js": { "maxDuration": 60 }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api" }
  ],
  "crons": [
    { "path": "/api/cron/notifications", "schedule": "0 2 * * *" }
  ]
}
