# ============================================================================
# ADEENA TRADERS - Backend Environment
# ============================================================================
# Local use:  copy this file to backend/.env and fill in the values.
# Vercel:     add the same keys under
#             Project -> Settings -> Environment Variables (Production).
#             Do NOT commit a real .env - it is gitignored for a reason.

# ---- Required ---------------------------------------------------------------
# The app refuses to start without these three.

# MongoDB connection string. On Atlas: Database -> Connect -> Drivers.
# A password containing @ : / ? # or % must be percent-encoded.
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/adeena_traders

# Signing keys for the access and refresh tokens. They must differ, and in
# production each must be at least 32 characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string-at-least-32-chars
JWT_REFRESH_SECRET=replace-me-with-a-different-long-random-string

# ---- Runtime ----------------------------------------------------------------
NODE_ENV=development
PORT=5000

# ---- Front-end origins ------------------------------------------------------
# CLIENT_URL is the primary front-end, used for links inside generated messages.
# ALLOWED_ORIGINS is the CORS allow-list: every origin the SPA is served from,
# comma-separated, with no trailing slash. In production a browser origin that
# is not listed here is refused, which shows up as a failing login.
CLIENT_URL=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:8000,http://localhost:5173

# ---- Tokens and cookies -----------------------------------------------------
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_EXPIRES_DAYS=7

# SameSite for the refresh cookie: none | lax | strict.
# Leave unset unless you need to override the default, which is:
#   development            -> lax
#   serverless (Vercel)    -> none   (the SPA and the API are on different hosts,
#                                     and 'strict' would stop the browser sending
#                                     the cookie at all - users would be signed
#                                     out every 15 minutes)
#   any other production   -> strict
# Set this to 'strict' when the API is served from the same domain as the SPA.
# COOKIE_SAME_SITE=strict

# ---- File uploads -----------------------------------------------------------
# Defaults to backend/uploads. On Vercel it defaults to /tmp/uploads, which is
# the only writable path - but /tmp is per-instance and is wiped when the
# instance is recycled, so uploaded files DO NOT survive there. Use a host with
# a persistent disk, or move uploads to object storage, before relying on them.
# UPLOAD_DIR=./uploads
MAX_FILE_UPLOAD_MB=8

# ---- Rate limiting ----------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_MAX=20

# ---- Background jobs --------------------------------------------------------
# How often the notification sweep runs, in minutes. 0 disables it.
# Only used when running as a real server (npm start). On Vercel the sweep is
# driven by Cron instead - see the "crons" block in backend/vercel.json.
NOTIFICATION_SWEEP_MINUTES=30

# Shared secret Vercel Cron presents when calling /api/cron/notifications.
# Required on Vercel: without it the sweep endpoint refuses to run.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# CRON_SECRET=

# ---- Bootstrap admin --------------------------------------------------------
# Only used by `npm run seed` against an empty database. Change the password
# immediately after the first sign-in.
DEFAULT_ADMIN_NAME=System Administrator
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_EMAIL=admin@adeenatraders.com
DEFAULT_ADMIN_PASSWORD=ChangeMe@123
