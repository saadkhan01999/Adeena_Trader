# ============================================================================
# ADEENA TRADERS - Frontend Environment
# ============================================================================
# Copy to frontend/.env only if you need to override the defaults.
#
# In development the Vite dev server proxies /api and /uploads to the backend
# on port 5000, so nothing here is required.
#
# For deployed builds the values live in frontend/.env.production, which is
# committed. Set a variable in your host's dashboard to override it.
#
# Every VITE_* value is compiled into the public JavaScript bundle. Never put a
# secret in this file or in any .env the frontend reads.

# Where the API lives. The trailing /api is added automatically if you leave it
# off, and a trailing slash is trimmed - so all of these behave identically:
#   https://your-api.up.railway.app
#   https://your-api.up.railway.app/
#   https://your-api.up.railway.app/api
# VITE_API_URL=https://your-api.up.railway.app/api

# Set this only when uploaded files are served from a different origin than the
# API (a CDN, an object-storage bucket).
# VITE_FILE_URL=https://files.yourshop.com
